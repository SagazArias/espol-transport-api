# Copia a .env:  Copy-Item .env.example .env

# development | production  (producción exige SMTP real y JWT fuerte)
APP_ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://espol:espol_dev@localhost:5432/espol_transport
JWT_SECRET=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- OTP / correo ---
# development + pruebas locales:
#   OTP_DELIVERY=log  → código en consola uvicorn (y dev_code si EXPOSE_DEV_OTP=true)
# producción / correo real al estudiante:
#   OTP_DELIVERY=smtp + SMTP_* (Gmail, SendGrid, Amazon SES, etc.)
OTP_DELIVERY=smtp
EXPOSE_DEV_OTP=false
EXPOSE_API_ERRORS=true

# Mailpit local (docker compose): SMTP_HOST=localhost SMTP_PORT=1025 SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=espol-transport@tudominio.com
SMTP_USE_TLS=true

STUDENT_OTP_TTL_MINUTES=15
STUDENT_OTP_RESEND_SECONDS=60

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Opcional: Google reCAPTCHA v3 (si está vacío, no se exige captcha)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Activar detrás de proxy HTTPS (Nginx, Caddy, Render, Railway)
FORCE_HTTPS_REDIRECT=false
