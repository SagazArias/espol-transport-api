# Copia a .env:  Copy-Item .env.example .env

APP_ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://espol:espol_dev@localhost:5432/espol_transport
JWT_SECRET=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- OTP / correo ---
# log    = código en consola (solo desarrollo local)
# resend = API Resend (recomendado en Render; no usa SMTP)
# smtp   = Mailpit local (docker compose, puerto 1025)
OTP_DELIVERY=log
EXPOSE_DEV_OTP=true
EXPOSE_API_ERRORS=true

# Resend (producción en Render) — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Dominio verificado en Resend; pruebas: onboarding@resend.dev
RESEND_FROM=ESPOL Transporte <onboarding@resend.dev>

# SMTP solo si OTP_DELIVERY=smtp (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM=espol-transport@localhost

STUDENT_OTP_TTL_MINUTES=15
STUDENT_OTP_RESEND_SECONDS=60

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

FORCE_HTTPS_REDIRECT=false
